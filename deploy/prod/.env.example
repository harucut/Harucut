# 하루컷 운영 서버 환경변수
# 서버에서 compose.yml 과 같은 폴더에 .env 로 복사한 뒤 값을 채운다.
# ⚠️ 값을 채우는 순간 자격증명 파일이다. 커밋 금지 (.gitignore 의 .env 가 막고 있다)

# ── 이미지 ────────────────────────────────────────────────────
# CI 가 배포할 때 커밋 SHA 로 바꿔 쓴다. 롤백은 이 값을 이전 SHA 로 되돌리고 up -d
IMAGE_TAG=latest

# ── DB ────────────────────────────────────────────────────────
# MySQL 컨테이너가 첫 기동 때 이 값으로 계정을 만든다.
# ⚠️ 첫 기동 이후에 바꾸면 반영되지 않는다 — 볼륨에 이미 계정이 있다
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=harucut
DB_USERNAME=harucut
DB_PASSWORD=

# ── JWT ───────────────────────────────────────────────────────
# 생성: openssl rand -base64 48   (바꾸면 발급된 토큰이 전부 무효)
JWT_SECRET_KEY=

# ── 쿠키 · 프론트 ─────────────────────────────────────────────
# api.harucut.com 과 harucut.com 이 쿠키를 나눠 쓰려면 상위 도메인으로
COOKIE_DOMAIN=harucut.com
COOKIE_SECURE=true
COOKIE_SAME_SITE=Lax
# 소셜 로그인 후 돌아갈 곳
FRONTEND_URL=https://harucut.com

# ── 메일 (Gmail SMTP) ─────────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true
MAIL_USERNAME=
# Google 계정 → 보안 → 앱 비밀번호 (16자리). 로그인 비밀번호로는 거부된다
MAIL_PASSWORD=
# MAIL_USERNAME 과 같게. 다르면 Gmail 이 어차피 로그인 주소로 바꿔 보낸다
MAIL_FROM=

# ── 소셜 로그인 ───────────────────────────────────────────────
# 각 콘솔에 리다이렉트 URI 등록: https://api.harucut.com/login/oauth2/code/{google|kakao|naver}
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
# 로그인용 secret 과 다른 키. 탈퇴 배치의 연결 끊기(unlink)에 쓴다
KAKAO_ADMIN_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ── AWS ───────────────────────────────────────────────────────
# SDK 표준 변수명이라 철자를 바꾸면 인식 안 된다
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
# 둘 다 비면 기동에서 죽는다 (LambdaComposeExecutor, ComposeResultConsumer)
COMPOSE_LAMBDA_FUNCTION=
COMPOSE_RESULT_QUEUE_URL=

# ── 스키마 ────────────────────────────────────────────────────
# prod 프로파일은 Flyway 켬 + ddl-auto validate 다. 기존 운영 DB 는 baseline 편입(docs/adr-0005 §3) 전에 배포하면 기동에서 죽는다.
# 끄는 값(FLYWAY_ENABLED=false)을 두지 말 것 — update 가 새 표를 먼저 만들면 그 뒤 migration 이 영영 실패한다

# ── 결제 ──────────────────────────────────────────────────────
# 실제 PG 구현 전까지 닫아 둔다 — 발급·청구가 전부 실패하고 웹훅은 PAY-008 로 거절된다.
# ⚠️ mock + PAYMENT_MOCK_ALLOWED=true 로 띄우면 로그인 사용자 누구나 임의 값으로 유료 구독을 얻는다
PAYMENT_GATEWAY_PROVIDER=disabled
PAYMENT_WEBHOOK_PROVIDER=disabled
PAYMENT_MOCK_ALLOWED=false
PAYMENT_GRACE_DAYS=3

# ── 스토어 구독 ───────────────────────────────────────────────
# real: 애플은 서명 검증(루트 인증서 필요 — 없으면 전부 거절), 구글은 아직 항상 거절(Play 검증 미구현).
# ⚠️ STORE_MOCK_ALLOWED 를 쓰지 말 것 — 목 검증기는 서명을 보지 않아 mock: 증빙으로 임의 등급을 얻는다
STORE_VERIFIER=real
# APPLE_ROOT_CERTIFICATES=

# ── 웹 경계 ───────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://harucut.com,https://www.harucut.com
# 프론트 BFF 와 같은 값. 이 값이 맞는 요청만 X-Harucut-Client-Ip 를 믿는다 — 비우면 빈도 제한이 BFF 출구 IP 하나로 묶인다
BFF_SHARED_SECRET=
# 같은 IP 의 행사 세션 발급·부스 연결·틀린 결과 토큰(분당, 기본 30). 행사장 Wi-Fi 는 참가자 전원이 한 IP 다 — 행사 규모에 맞춘다
# EVENT_PARTICIPATION_PUBLIC_REQUESTS_PER_MINUTE=30

# ── 업로드 ────────────────────────────────────────────────────
# S3 버킷 CORS 의 AllowedHeaders 에 If-None-Match 가 있는지 확인하기 전에는 끈다 — 없으면 브라우저 업로드가 전부 막힌다
STORAGE_UPLOAD_CONDITIONAL_PUT=false

# ── 첫 배포 때만 — 배치 첫 실행을 끄고 규모를 본 뒤 줄을 지운다 ────
# 보관 종료(매일 04:00)와 미참조 자산 정리(매일 03:00)는 쌓인 것을 한 번에 지운다. "-" 면 돌지 않는다
EVENT_RETENTION_CRON=-
STORAGE_ASSET_ORPHAN_CLEANUP_CRON=-

# ── 합성 Lambda 를 새 빌드로 배포한 뒤에만 켠다 ─────────────────
# 구형 Lambda 에 2 를 주면 모든 합성이 OUTPUT_CONFLICT 로 실패한다(docs/adr-0013)
# COMPOSE_OUTPUT_CONTRACT=2
# COMPOSE_FREE_CELLS_ENABLED=true

# ── 푸시 ──────────────────────────────────────────────────────
# 기본 log 는 로그만 남긴다. expo 는 EAS projectId·액세스 토큰이 필요하다(실연동 미확인)
# PUSH_SENDER=expo
# EXPO_ACCESS_TOKEN=

# ── Swagger ───────────────────────────────────────────────────
# prod 기본은 꺼짐. 켜면 관리자 API 명세까지 인증 없이 열리고, 병렬 호출 몇 개로 앱 컨테이너가 OOM 으로 죽는다
SPRINGDOC_API_DOCS_ENABLED=false
SPRINGDOC_SWAGGER_UI_ENABLED=false
